[Desktop Entry]
Type=Application
Name=Passwords
Name[uk]=Паролі
GenericName=Password Manager
GenericName[uk]=Менеджер паролів
Comment=Keep logins, codes and secure notes, fill them into apps and send secrets
Comment[uk]=Логіни, коди й секретні нотатки: зберігати, вставляти в застосунки й надсилати
Exec=glide-passwords
Icon=dialog-password
Terminal=false
Categories=Utility;Security;
Keywords=password;passwords;keychain;bitwarden;vaultwarden;totp;passkey;паролі;пароль;логін;сховище;
StartupNotify=true
StartupWMClass=glide-passwords
