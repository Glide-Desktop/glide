<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Glide</vendor>
  <icon_name>glide-settings</icon_name>

  <action id="org.glide.facekey.enroll">
    <description>Add your face</description>
    <description xml:lang="uk">Додати обличчя</description>
    <message>Confirm it is you: enter your password to add your face</message>
    <message xml:lang="uk">Підтвердьте, що це ви: введіть пароль, щоб додати обличчя</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/facekey</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">-enroll</annotate>
  </action>

  <action id="org.glide.facekey.delete">
    <description>Remove your face</description>
    <description xml:lang="uk">Видалити обличчя</description>
    <message>Confirm it is you: enter your password to remove your face</message>
    <message xml:lang="uk">Підтвердьте, що це ви: введіть пароль, щоб видалити обличчя</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/facekey</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">-delete-profile</annotate>
  </action>

  <action id="org.glide.facekey.pam-enable">
    <description>Use your face for system sign-in</description>
    <description xml:lang="uk">Впізнавати обличчя для входу в систему</description>
    <message>Enter the administrator password to let your face confirm system actions</message>
    <message xml:lang="uk">Введіть пароль адміністратора, щоб обличчя підтверджувало дії в системі</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/facekey</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">-pam-enable</annotate>
  </action>

  <action id="org.glide.facekey.pam-disable">
    <description>Stop using your face for system sign-in</description>
    <description xml:lang="uk">Не впізнавати обличчя для входу в систему</description>
    <message>Enter the administrator password to stop face recognition for system actions</message>
    <message xml:lang="uk">Введіть пароль адміністратора, щоб вимкнути впізнавання обличчя для дій у системі</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/facekey</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">-pam-disable</annotate>
  </action>
</policyconfig>
