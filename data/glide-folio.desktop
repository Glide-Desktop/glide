[Desktop Entry]
Type=Application
Name=Folio
Name[uk]=Фоліо
GenericName=Document Viewer
GenericName[uk]=Переглядач документів
Comment=Read, search and annotate PDFs, books, comics and scans
Comment[uk]=Читати, шукати й позначати PDF, книжки, комікси та скани
Exec=glide-folio %F
Icon=glide-folio
Terminal=false
Categories=Office;Viewer;Graphics;
Keywords=pdf;document;viewer;reader;ebook;epub;djvu;comic;cbz;xps;postscript;annotate;sign;документ;переглядач;книжка;комікс;скан;нотатки;підпис;
MimeType=application/pdf;application/x-pdf;application/postscript;image/x-eps;application/eps;image/vnd.djvu;image/vnd.djvu+multipage;application/oxps;application/vnd.ms-xpsdocument;image/tiff;application/vnd.comicbook+zip;application/x-cbz;application/vnd.comicbook-rar;application/x-cbr;application/x-cb7;application/x-cbt;application/epub+zip;application/x-fictionbook+xml;
StartupNotify=true
StartupWMClass=glide-folio
