pkgname=glide
pkgver=0.1.3
pkgrel=1
pkgdesc="Wayland desktop: compositor with its own shell (top bar, dock, launcher, overview, notifications) and apps"
arch=(x86_64)
url="https://github.com/Glide-Desktop/glide"
license=(GPL-3.0-or-later)
depends=(
    dbus
    dconf
    fontconfig
    gcc-libs
    glib2
    glibc
    gsettings-desktop-schemas
    gst-libav
    gst-plugins-bad
    gst-plugins-bad-libs
    gst-plugins-base
    gst-plugins-base-libs
    gst-plugins-good
    gstreamer
    hicolor-icon-theme
    libdisplay-info
    libinput
    libpulse
    libxkbcommon
    mesa
    pam
    pipewire
    pipewire-audio
    pipewire-pulse
    polkit
    seatd
    systemd-libs
    wireplumber
    wl-clipboard
    xdg-desktop-portal
    xdg-desktop-portal-gtk
    xdg-desktop-portal-wlr
    xdg-utils
    xwayland-satellite
)
makedepends=(cargo git pkgconf)
optdepends=(
    'rtkit: realtime priority for PipeWire; without it sound crackles under load'
    'brightnessctl: brightness and keyboard backlight keys'
    'networkmanager: Wi-Fi, VPN, hotspot and screen mirroring in quick settings and Settings'
    'networkmanager-openvpn: importing OpenVPN connections in Settings'
    'bluez: Bluetooth'
    'bluez-utils: Bluetooth devices in quick settings (bluetoothctl)'
    'upower: battery charge limit in quick settings and Settings'
    'power-profiles-daemon: power profiles in quick settings and Settings'
    'accountsservice: Users in Settings'
    'cups: Printers in Settings'
    'pciutils: graphics card name in Settings › About'
    'iw: Wi-Fi network name without NetworkManager'
    'udisks2: removable drives in Glide Files'
    'ntfs-3g: NTFS drives that the kernel driver refuses'
    'ntfsprogs: repairing NTFS drives in Glide Files'
    'gvfs-mtp: phones in Glide Files'
    'gvfs-gphoto2: cameras in Glide Files'
    'greetd: Glide as the display manager (glide --greeter)'
    'gst-plugin-va: hardware video decoding, tone mapping and encoding in Glide Clips and screen mirroring'
    'gst-plugin-pipewire: sound in screen mirroring'
    'gst-plugins-ugly: screen mirroring and export with x264'
    'intel-media-driver: hardware video on Intel graphics'
    'tesseract: text recognition in Glide Clips and Glide Folio'
    'tesseract-data-ukr: Ukrainian text recognition'
    'ghostscript: PostScript and EPS in Glide Folio'
    'djvulibre: DjVu in Glide Folio'
    'libgxps: XPS and OXPS in Glide Folio'
    'libreoffice-fresh: Office documents in Glide Folio'
    'libarchive: Extract and Compress in Glide Files, comic archives in Glide Folio'
    '7zip: CB7 comics in Glide Folio'
    'unrar: CBR comics in Glide Folio'
    'libheif: HEIC and HEIF in Glide Photos'
    'libjxl: JPEG XL in Glide Photos'
    'imagemagick: AVIF, PSD and other formats in Glide Photos'
    'man-db: Open man Page in Glide Terminal'
    'sound-theme-freedesktop: notification and bell sounds'
    'adwaita-cursors: a cursor theme'
    'noto-fonts-emoji: emoji'
    'noto-fonts-cjk: Chinese, Japanese and Korean text'
    'adw-gtk-theme: GTK 3, Chrome and Electron apps in Glide colours'
    'qt6ct: Qt 6 apps in Glide colours'
    'qt5ct: Qt 5 apps in Glide colours'
    'kvantum: Qt controls in Glide shapes'
    'colloid-icon-theme-git: the default icon theme (AUR)'
    'papirus-icon-theme: icons when Colloid is not installed'
    'netbird: NetBird VPN integration'
)
provides=(org.freedesktop.secrets)
conflicts=(glide-secret-service)
replaces=(glide-secret-service)
backup=(etc/pam.d/glide-lock)
options=(!lto !debug)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --workspace
}

package() {
    cd "$pkgname-$pkgver"
    sh scripts/install.sh --destdir "$pkgdir" --prefix /usr --from target/release
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
